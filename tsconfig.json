{
    "compilerOptions": {
        "outDir": "./dist/",
        "sourceMap": true,
        "noImplicitAny": true,
        "module": "esnext",
        "target": "esnext",
        "jsx": "react-jsx",
        "lib": ["dom", "dom.iterable", "esnext"],
        "moduleResolution": "node",
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true
    }
}
